# 服务器配置
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# 前端地址（CORS）
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,file://

# JWT 配置
JWT_SECRET=kmc-super-secret-key-change-this-in-production-2026
JWT_EXPIRES_IN=7d

# 数据库配置
DB_PATH=./kmc.db

# 日志配置
LOG_LEVEL=info

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50mb
